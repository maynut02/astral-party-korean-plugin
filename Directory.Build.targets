<Project>
  <PropertyGroup Condition="'$(AstralPluginProject)' == 'true'">
    <Version>$(AstralPluginVersion)</Version>
    <AstralPluginCoreVersion>$([System.Text.RegularExpressions.Regex]::Match('$(AstralPluginVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</AstralPluginCoreVersion>
    <AssemblyVersion>$(AstralPluginCoreVersion).0</AssemblyVersion>
    <FileVersion>$(AstralPluginCoreVersion).0</FileVersion>
    <InformationalVersion>$(AstralPluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <Target Name="ValidateAstralPluginVersion" BeforeTargets="Restore;_GenerateRestoreProjectSpec;PrepareForBuild;GetAssemblyVersion;CoreCompile" Condition="'$(AstralPluginProject)' == 'true'">
    <Error Condition="'$(AstralPluginVersion)' == ''" Text="Missing AstralPluginVersion. Use scripts/build.ps1 or pass -p:AstralPluginVersion=X.Y.Z[-prerelease]." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(AstralPluginVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'))" Text="AstralPluginVersion must contain canonical SemVer X.Y.Z with optional prerelease/build metadata." />
    <Error Condition="$([System.Version]::Parse('$(AstralPluginCoreVersion)').Major) &gt; 65534 or $([System.Version]::Parse('$(AstralPluginCoreVersion)').Minor) &gt; 65534 or $([System.Version]::Parse('$(AstralPluginCoreVersion)').Build) &gt; 65534" Text="Version components must be between 0 and 65534 for .NET assembly metadata." />
  </Target>

  <Target Name="GenerateAstralPluginVersion" BeforeTargets="CoreCompile" DependsOnTargets="ValidateAstralPluginVersion" Condition="'$(AstralPluginProject)' == 'true'">
    <PropertyGroup>
      <AstralGeneratedVersionFile>$(IntermediateOutputPath)AstralBuildVersion.g.cs</AstralGeneratedVersionFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(AstralGeneratedVersionFile)" Lines="internal static class AstralBuildVersion { public const string Value = &quot;$(AstralPluginVersion)&quot;%3B public const string Core = &quot;$(AstralPluginCoreVersion)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(AstralGeneratedVersionFile)" />
      <FileWrites Include="$(AstralGeneratedVersionFile)" />
    </ItemGroup>
  </Target>
</Project>
